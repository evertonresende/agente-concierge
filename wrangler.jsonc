{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // O topo não tem variáveis, bindings nem secrets: um deploy sem --env não tem
  // catálogo nem webhook para chamar. Todo comando usa --env dev ou --env producao.
  "name": "concierge",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-13",
  // global_fetch_strictly_public: sem ela, um Worker recém-criado no endereço padrão
  // pode responder 404 "error code: 1042" ao ser chamado por outro Worker da conta.
  "compatibility_flags": ["global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "exports": { "Sessao": { "type": "durable-object", "storage": "sqlite" } },
  "env": {
    "dev": {
      "ai": { "binding": "AI" },
      "durable_objects": { "bindings": [{ "name": "SESSAO", "class_name": "Sessao" }] },
      "vars": {
        "AMBIENTE": "dev",
        // Principal escolhido pelo Éverton (X22): Claude Haiku 5.5, pela binding do AI Gateway,
        // com a chave da Anthropic guardada no gateway (BYOK). Raciocínio em nível alto (decisão do
        // Éverton, 13/11; muito alto descartado).
        "MODELO": "anthropic/claude-haiku-5.5",
        "MODELO_ESFORCO": "high",
        // Reserva provisório (X22), de outro fornecedor, no Workers AI, sem chave de terceiro.
        "MODELO_RESERVA": "@cf/zai-org/glm-5.3-flash",
        "AI_GATEWAY": "concierge-dev",
        "ENVIO_LEADS": "ligado"
      },
      "secrets": { "required": ["CATALOGO_URL", "LEADS_URL"] }
    },
    "producao": {
      "ai": { "binding": "AI" },
      "durable_objects": { "bindings": [{ "name": "SESSAO", "class_name": "Sessao" }] },
      // URLs de pré-visualização desligadas (P25); sem isto o deploy as religa.
      "preview_urls": false,
      "vars": {
        "AMBIENTE": "producao",
        "MODELO": "anthropic/claude-haiku-5.5",
        "MODELO_ESFORCO": "high",
        "MODELO_RESERVA": "@cf/zai-org/glm-5.3-flash",
        // Gateway próprio de producao, com a chave da Anthropic guardada nele (BYOK, apelido
        // default), criado pela frente K com autorização do Éverton em 13/11.
        "AI_GATEWAY": "concierge-producao",
        // Ligado por ordem do Éverton em 14/11 (contrato L24).
        "ENVIO_LEADS": "ligado"
      },
      "secrets": { "required": ["CATALOGO_URL", "LEADS_URL"] }
    }
  }
}
